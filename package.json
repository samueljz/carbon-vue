{
    "name": "@carbon/vue",
    "version": "0.1.0",
    "description": "Vue 3 wrapper components for Carbon Design System web components",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./components/*": {
            "types": "./dist/components/*/index.d.ts",
            "import": "./dist/components/*/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "storybook": "storybook dev -p 7007",
        "storybook:build": "storybook build",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@carbon/icons-vue": "^10.99.1",
        "@carbon/web-components": "^2.47.0",
        "vue": "^3.4.0"
    },
    "devDependencies": {
        "@carbon/icons": "^11.74.0",
        "@carbon/layout": "^11.47.0",
        "@carbon/styles": "^1.99.0",
        "@carbon/themes": "^11.50.0",
        "@storybook/addon-docs": "^8.5.0",
        "@storybook/addon-essentials": "^8.5.0",
        "@storybook/addon-links": "^8.5.0",
        "@storybook/blocks": "^8.5.0",
        "@storybook/vue3": "^8.5.0",
        "@storybook/vue3-vite": "^8.5.0",
        "@types/carbon__layout": "^0.0.3",
        "@types/node": "^22.0.0",
        "@vitejs/plugin-vue": "^5.2.0",
        "@vue/tsconfig": "^0.7.0",
        "eslint": "^9.0.0",
        "eslint-plugin-vue": "^9.32.0",
        "remark-gfm": "^4.0.0",
        "sass": "^1.93.0",
        "storybook": "^8.5.0",
        "typescript": "~5.7.0",
        "vite": "^6.0.0",
        "vue-tsc": "^2.2.0"
    },
    "peerDependencies": {
        "vue": "^3.4.0"
    },
    "keywords": [
        "carbon",
        "carbon-design-system",
        "vue",
        "vue3",
        "components",
        "web-components"
    ],
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/carbon-design-system/carbon.git"
    }
}
